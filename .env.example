# Copy to .env.local and fill in. Never commit real values.

# Signs the demo session cookie (HMAC-SHA256). Use a long random string in any shared deployment.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: override the demo buyer/provider passwords (defaults are documented in README.md)
# DEMO_BUYER_PASSWORD=
# DEMO_PROVIDER_PASSWORD=

# Unlisted path of the Elets operations sign-in, e.g. /ops-k7q2m9x4 (defaults to /ops-login).
# Create operations accounts with: node scripts/create-admin.mjs --email ... --name "..."
OPS_LOGIN_PATH=

# Set to "true" to remove the one-click "Continue as demo …" sign-in buttons' backend.
# DISABLE_DEMO_LOGIN=true

# Neon / Postgres connection string for shared marketplace data (see README "Shared data in Neon").
# Without it, data is kept per-browser in localStorage.
DATABASE_URL=

# Supabase (not yet wired into the UI — see README "Database configuration")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for admin scripts / seeding; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

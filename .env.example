# Copy to .env.local and fill in. Never commit real values.

# Signs the demo session cookie (HMAC-SHA256). Use a long random string in any shared deployment.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: override the demo account passwords (defaults are documented in README.md)
# DEMO_BUYER_PASSWORD=
# DEMO_PROVIDER_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# Set to "true" to remove the one-click "Continue as demo …" sign-in buttons' backend.
# DISABLE_DEMO_LOGIN=true

# Supabase (not yet wired into the UI — see README "Database configuration")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for admin scripts / seeding; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
